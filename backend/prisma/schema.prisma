generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum WorkspaceRole {
    owner
    admin
    member
    viewer
}

enum ProjectRoleEnum {
    owner
    admin
    member
    viewer
}

// ═══════════════════════════════════════════════════════════════
// TENANT / ORGANIZATION
// ═══════════════════════════════════════════════════════════════

model Organization {
    id         String               @id @default(uuid(7)) @db.Uuid
    name       String
    createdAt  DateTime             @default(now())
    updatedAt  DateTime             @updatedAt
    categories Category[]
    tags       Tag[]
    skills     Skill[]
    userSkills UserSkill[]
    workspaces Workspace[]
    members    OrganizationMember[]

    @@map("organizations")
}

model OrganizationMember {
    id             String  @id @default(uuid(7)) @db.Uuid
    organizationId String  @db.Uuid
    userId         String  @db.Uuid
    role           OrgRole @default(MEMBER)

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([organizationId, userId])
    @@index([userId])
    @@map("organization_members")
}

enum OrgRole {
    OWNER
    ADMIN
    MEMBER
}

// ═══════════════════════════════════════════════════════════════
// WORKSPACE
// ═══════════════════════════════════════════════════════════════

model Workspace {
    id             String   @id @default(uuid(7)) @db.Uuid
    organizationId String   @db.Uuid
    name           String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    members  WorkspaceMember[]
    projects Project[]

    @@index([organizationId])
    @@map("workspaces")
}

model WorkspaceMember {
    id          String        @id @default(uuid(7)) @db.Uuid
    workspaceId String        @db.Uuid
    userId      String        @db.Uuid
    role        WorkspaceRole @default(member)
    createdAt   DateTime      @default(now()) // ← добавить

    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([workspaceId, userId])
    @@index([userId])
    @@map("workspace_members")
}

// ═══════════════════════════════════════════════════════════════
// USERS
// ═══════════════════════════════════════════════════════════════

model User {
    id           String   @id @default(uuid(7)) @db.Uuid
    email        String   @unique
    passwordHash String
    name         String?
    avatarUrl    String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    organizationMemberships OrganizationMember[]
    workspaceMemberships    WorkspaceMember[]
    projectMemberships      ProjectMember[]

    createdRecords     Record[]
    comments           Comment[]
    uploadedFiles      File[]
    activityLogs       ActivityLog[]
    refreshTokens      RefreshToken[]
    emailVerifications EmailVerification[]
    status             UserStatus          @default(ACTIVE)
    createdUtmLinks    UtmLink[]
    sprintEvents       SprintEvent[]
    increments         Increment[]
    createdTags        Tag[]
    userSkills         UserSkill[]
    createdEvidences   SkillEvidence[]
    invitations        Invitation[]

    @@map("users")
}

enum UserStatus {
    ACTIVE
    SUSPENDED
    DELETED
}

// ═══════════════════════════════════════════════════════════════
// PROJECTS
// ═══════════════════════════════════════════════════════════════

model Project {
    id          String        @id @default(uuid(7)) @db.Uuid
    workspaceId String        @db.Uuid
    name        String
    description String?
    status      ProjectStatus @default(ACTIVE)
    startDate   DateTime?
    endDate     DateTime?
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    members             ProjectMember[]
    modules             ProjectModule[]
    entities            Entity[]
    records             Record[]
    workflows           Workflow[]
    files               File[]
    activityLogs        ActivityLog[]
    marketingDashboards MarketingDashboard[]

    artifacts        Artifact[]
    utmSources       UtmSource[]
    utmMediums       UtmMedium[]
    utmCampaigns     UtmCampaign[]
    utmRules         UtmRule[]
    utmLinks         UtmLink[]
    views            View[]
    sprints          Sprint[]
    increments       Increment[]
    epics            Epic[]
    taskComplexities TaskComplexity[]
    invitations      Invitation[]

    @@index([workspaceId])
    @@map("projects")
}

enum ProjectStatus {
    ACTIVE
    ARCHIVED
    COMPLETED
}

model ProjectMember {
    id        String          @id @default(uuid(7)) @db.Uuid
    projectId String          @db.Uuid
    userId    String          @db.Uuid
    role      ProjectRoleEnum @default(member)
    createdAt DateTime        @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([userId])
    @@map("project_members")
}

// ═══════════════════════════════════════════════════════════════
// CORE: MODULES
// ═══════════════════════════════════════════════════════════════

model ProjectModule {
    id        String  @id @default(uuid(7)) @db.Uuid
    projectId String  @db.Uuid
    name      String
    label     String
    icon      String?
    config    Json    @default("{}")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    entities Entity[]

    @@unique([projectId, name])
    @@index([projectId])
    @@map("project_modules")
}

// ═══════════════════════════════════════════════════════════════
// CORE: ENTITIES
// ═══════════════════════════════════════════════════════════════

model Entity {
    id        String  @id @default(uuid(7)) @db.Uuid
    projectId String  @db.Uuid
    moduleId  String? @db.Uuid

    name      String
    label     String
    icon      String?
    color     String?
    isSystem  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
    module  ProjectModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

    fields    Field[]
    records   Record[]
    workflows Workflow[]
    views     View[]

    @@unique([projectId, name])
    @@index([projectId])
    @@index([moduleId])
    @@map("entities")
}

// ═══════════════════════════════════════════════════════════════
// CORE: FIELDS
// ═══════════════════════════════════════════════════════════════

model Field {
    // Оставляем String намеренно.
    // Типы будут расширяться через FieldTypeRegistry.
    id       String @id @default(uuid(7)) @db.Uuid
    entityId String @db.Uuid

    name  String
    label String
    type  String

    options      Json?
    isRequired   Boolean @default(false)
    defaultValue Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

    @@unique([entityId, name])
    @@index([entityId])
    @@map("fields")
}

// ═══════════════════════════════════════════════════════════════
// RECORDS
// ═══════════════════════════════════════════════════════════════

model Record {
    id        String @id @default(uuid(7)) @db.Uuid
    entityId  String @db.Uuid
    projectId String @db.Uuid

    data           Json
    taskComplexity TaskComplexity?
    createdById    String          @db.Uuid
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    creator User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

    comments      Comment[]
    recordIndexes RecordIndex[]

    @@index([projectId])
    @@index([entityId])
    @@index([projectId, entityId])
    @@index([createdById])
    @@map("records")
}

model RecordIndex {
    id        String @id @default(uuid(7)) @db.Uuid
    recordId  String @db.Uuid
    entityId  String @db.Uuid
    projectId String @db.Uuid
    fieldName String
    fieldType String // text, number, date, boolean, select, user

    // Типизированные значения для быстрой сортировки/фильтрации
    valueText   String?
    valueNumber Float?
    valueDate   DateTime?
    valueBool   Boolean?

    createdAt DateTime @default(now())

    record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

    @@index([entityId, fieldName, valueText])
    @@index([entityId, fieldName, valueNumber])
    @@index([entityId, fieldName, valueDate])
    @@index([entityId, fieldName, valueBool])
    @@index([recordId])
    @@map("record_indexes")
}

// ═══════════════════════════════════════════════════════════════
// WORKFLOWS
// ═══════════════════════════════════════════════════════════════

model Workflow {
    id        String @id @default(uuid(7)) @db.Uuid
    projectId String @db.Uuid
    entityId  String @db.Uuid
    name      String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

    steps       WorkflowStep[]
    transitions WorkflowTransition[]

    @@unique([projectId, entityId, name])
    @@index([projectId])
    @@index([entityId])
    @@map("workflows")
}

// ═══════════════════════════════════════════════════════════════
// WORKFLOW STEPS
// ═══════════════════════════════════════════════════════════════

model WorkflowStep {
    id         String @id @default(uuid(7)) @db.Uuid
    workflowId String @db.Uuid

    name  String
    order Int
    color String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

    outgoingTransitions WorkflowTransition[] @relation("fromStep")
    incomingTransitions WorkflowTransition[] @relation("toStep")

    @@unique([workflowId, order])
    @@index([workflowId])
    @@map("workflow_steps")
}

// ═══════════════════════════════════════════════════════════════
// WORKFLOW TRANSITIONS
// ═══════════════════════════════════════════════════════════════

model WorkflowTransition {
    id         String @id @default(uuid(7)) @db.Uuid
    workflowId String @db.Uuid

    fromStepId String @db.Uuid
    toStepId   String @db.Uuid

    name       String?
    conditions Json?
    actions    Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    workflow Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
    fromStep WorkflowStep @relation("fromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
    toStep   WorkflowStep @relation("toStep", fields: [toStepId], references: [id], onDelete: Cascade)

    @@index([workflowId])
    @@index([fromStepId])
    @@index([toStepId])
    @@map("workflow_transitions")
}

// ═══════════════════════════════════════════════════════════════
// COMMENTS
// ═══════════════════════════════════════════════════════════════

model Comment {
    id       String @id @default(uuid(7)) @db.Uuid
    recordId String @db.Uuid
    userId   String @db.Uuid
    body     String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([recordId, createdAt])
    @@index([userId])
    @@map("comments")
}

// ═══════════════════════════════════════════════════════════════
// FILES
// ═══════════════════════════════════════════════════════════════

model File {
    id        String @id @default(uuid(7)) @db.Uuid
    projectId String @db.Uuid
    userId    String @db.Uuid

    storageKey   String
    originalName String
    mimeType     String
    size         Int
    metadata     Json?

    createdAt DateTime @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([userId])
    @@map("files")
}

// ═══════════════════════════════════════════════════════════════
// ACTIVITY LOG
// ═══════════════════════════════════════════════════════════════

model ActivityLog {
    id String @id @default(uuid(7)) @db.Uuid

    projectId String? @db.Uuid
    userId    String  @db.Uuid

    action String

    entityType String
    entityId   String @db.Uuid

    metadata Json?

    createdAt DateTime @default(now())

    project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([projectId, createdAt])
    @@index([entityType, entityId, createdAt])
    @@index([userId, createdAt])
    @@map("activity_logs")
}

// ═══════════════════════════════════════════════════════════════
// AUTH
// ═══════════════════════════════════════════════════════════════

model RefreshToken {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @db.Uuid
    selector  String    @unique
    tokenHash String    @unique
    device    String?
    ip        String?
    userAgent String?
    expiresAt DateTime
    revokedAt DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("refresh_tokens")
}

model EmailVerification {
    id         String    @id @default(uuid(7)) @db.Uuid
    userId     String    @db.Uuid
    codeHash   String
    expiresAt  DateTime
    verifiedAt DateTime?
    createdAt  DateTime  @default(now())

    user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
    attempts Int  @default(0)

    @@index([userId])
    @@map("email_verifications")
}

model LoginAttempt {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String?  @db.Uuid
    email     String
    ip        String
    userAgent String?
    success   Boolean
    createdAt DateTime @default(now())

    @@index([email, createdAt])
    @@index([ip, createdAt])
    @@map("login_attempts")
}

// ═══════════════════════════════════════════════════════════════
// MARKETING DASHBOARD
// ═══════════════════════════════════════════════════════════════

model MarketingDashboard {
    id         String   @id @default(uuid(7)) @db.Uuid
    projectId  String   @db.Uuid
    periodFrom DateTime
    periodTo   DateTime

    // Бюджет
    adBudget       Float @default(0)
    marketingCosts Float @default(0)
    revenue        Float @default(0)
    grossProfit    Float @default(0)

    // Воронка
    impressions Float @default(0)
    clicks      Float @default(0)
    leads       Float @default(0)
    mql         Float @default(0)
    sql         Float @default(0)
    meetings    Float @default(0)
    offers      Float @default(0)
    deals       Float @default(0)

    // Продажи
    avgCheck            Float @default(0)
    avgGrossMargin      Float @default(0)
    avgLifetimeMonths   Float @default(0)
    avgPurchaseFreq     Float @default(0)
    avgRevenuePerClient Float @default(0)
    activeClients       Float @default(0)
    repeatClients       Float @default(0)
    retention           Float @default(0)

    // Дополнительно
    avgProductPrice  Float @default(0)
    operationalCosts Float @default(0)
    organicVisits    Float @default(0)
    totalVisits      Float @default(0)
    bounces          Float @default(0)
    newClients       Float @default(0)
    tam              Float @default(0)
    sam              Float @default(0)
    som              Float @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([projectId, periodFrom])
    @@map("marketing_dashboards")
}

// ═══════════════════════════════════════════════════════════════
// ARTIFACTS — ресурсы проекта
// ═══════════════════════════════════════════════════════════════

model Artifact {
    id          String       @id @default(uuid(7)) @db.Uuid
    projectId   String       @db.Uuid
    type        ArtifactType
    name        String
    url         String?
    description String?
    metadata    Json?
    isActive    Boolean      @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    utmLinks UtmLink[]

    @@index([projectId])
    @@index([projectId, type])
    @@map("artifacts")
}

enum ArtifactType {
    WEBSITE
    SOCIAL
    DOCUMENT
    DASHBOARD
    VIDEO
    FILE
    OFFLINE
    CUSTOM
}

// ═══════════════════════════════════════════════════════════════
// UTM — справочники
// ═══════════════════════════════════════════════════════════════

model UtmSource {
    id        String  @id @default(uuid(7)) @db.Uuid
    projectId String  @db.Uuid
    name      String
    label     String
    icon      String?
    isSystem  Boolean @default(false)

    createdAt DateTime @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([projectId, name])
    @@index([projectId])
    @@map("utm_sources")
}

model UtmMedium {
    id        String  @id @default(uuid(7)) @db.Uuid
    projectId String  @db.Uuid
    name      String
    label     String
    isSystem  Boolean @default(false)

    createdAt DateTime @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([projectId, name])
    @@index([projectId])
    @@map("utm_mediums")
}

model UtmCampaign {
    id        String    @id @default(uuid(7)) @db.Uuid
    projectId String    @db.Uuid
    name      String
    label     String
    startDate DateTime?
    endDate   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    utmLinks UtmLink[]

    @@unique([projectId, name])
    @@index([projectId])
    @@map("utm_campaigns")
}

// ═══════════════════════════════════════════════════════════════
// UTM — правила автогенерации
// ═══════════════════════════════════════════════════════════════

model UtmRule {
    id          String  @id @default(uuid(7)) @db.Uuid
    projectId   String  @db.Uuid
    name        String
    description String?
    priority    Int     @default(0)
    isActive    Boolean @default(true)

    // Условия (JSON-массив)
    // Пример: [{ "field": "artifact.type", "operator": "eq", "value": "SOCIAL" }]
    conditions Json @default("[]")

    // Шаблоны UTM
    sourceTemplate   String
    mediumTemplate   String
    campaignTemplate String?
    contentTemplate  String?
    termTemplate     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@map("utm_rules")
}

// ═══════════════════════════════════════════════════════════════
// UTM — сгенерированные ссылки
// ═══════════════════════════════════════════════════════════════

model UtmLink {
    id         String  @id @default(uuid(7)) @db.Uuid
    projectId  String  @db.Uuid
    artifactId String? @db.Uuid
    campaignId String? @db.Uuid

    source   String
    medium   String
    campaign String?
    content  String?
    term     String?

    baseUrl String
    fullUrl String

    label String?
    notes String?

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    createdById String   @db.Uuid

    project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
    artifact    Artifact?    @relation(fields: [artifactId], references: [id], onDelete: SetNull)
    campaignRef UtmCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
    createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([projectId])
    @@index([projectId, campaignId])
    @@index([artifactId])
    @@map("utm_links")
}

model View {
    id        String   @id @default(uuid(7)) @db.Uuid
    entityId  String   @db.Uuid
    projectId String   @db.Uuid
    name      String
    type      ViewType @default(KANBAN)
    config    Json     @default("{}")
    isDefault Boolean  @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([entityId])
    @@index([projectId])
    @@map("views")
}

enum ViewType {
    TABLE
    KANBAN
    CALENDAR
    LIST
}

// ═══════════════════════════════════════════════════════════════
// SCRUM: SPRINTS
// ═══════════════════════════════════════════════════════════════

model Sprint {
    id          String       @id @default(uuid(7)) @db.Uuid
    projectId   String       @db.Uuid
    name        String
    number      Int
    goal        String?
    description String?
    startDate   DateTime
    endDate     DateTime
    status      SprintStatus @default(PLANNED)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
    metrics    SprintMetric[]
    events     SprintEvent[]
    increments Increment[]

    @@unique([projectId, number])
    @@index([projectId])
    @@index([projectId, status])
    @@map("sprints")
}

enum SprintStatus {
    PLANNED
    ACTIVE
    COMPLETED
    CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// SCRUM: SPRINT METRICS
// ═══════════════════════════════════════════════════════════════

model SprintMetric {
    id       String @id @default(uuid(7)) @db.Uuid
    sprintId String @db.Uuid

    key         String // "leads", "cpl", "deals", "increments"
    label       String
    metricType  MetricType // INCREASE | DECREASE | TARGET
    targetValue Float
    actualValue Float?
    unit        String? // "%", "₽", "шт."
    xpReward    Int        @default(0)
    isAchieved  Boolean    @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

    @@index([sprintId])
    @@map("sprint_metrics")
}

enum MetricType {
    INCREASE
    DECREASE
    TARGET
}

// ═══════════════════════════════════════════════════════════════
// SCRUM: SPRINT EVENTS (success, failure, pivot, etc)
// ═══════════════════════════════════════════════════════════════

model SprintEvent {
    id          String          @id @default(uuid(7)) @db.Uuid
    sprintId    String          @db.Uuid
    type        SprintEventType
    title       String
    body        String?
    xp          Int             @default(0)
    createdById String          @db.Uuid

    createdAt DateTime @default(now())

    sprint    Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
    createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([sprintId])
    @@map("sprint_events")
}

enum SprintEventType {
    SUCCESS
    PARTIAL_SUCCESS
    FAILURE
    PIVOT
    PAUSE
    BREAKTHROUGH
}

// ═══════════════════════════════════════════════════════════════
// SCRUM: INCREMENTS
// ═══════════════════════════════════════════════════════════════

model Increment {
    id        String @id @default(uuid(7)) @db.Uuid
    sprintId  String @db.Uuid
    projectId String @db.Uuid

    name        String
    description String?
    icon        String?
    xp          Int     @default(0)

    createdById String   @db.Uuid
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    sprint    Sprint  @relation(fields: [sprintId], references: [id], onDelete: Cascade)
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([sprintId])
    @@index([projectId])
    @@map("increments")
}

// ═══════════════════════════════════════════════════════════════
// SCRUM: EPICS
// ═══════════════════════════════════════════════════════════════

model Epic {
    id          String     @id @default(uuid(7)) @db.Uuid
    projectId   String     @db.Uuid
    name        String
    description String?
    color       String?
    status      EpicStatus @default(OPEN)
    startDate   DateTime?
    endDate     DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([projectId, status])
    @@map("epics")
}

enum EpicStatus {
    OPEN
    IN_PROGRESS
    DONE
    CANCELLED
}

model Tag {
    id             String @id @default(uuid(7)) @db.Uuid
    organizationId String @db.Uuid

    name        String
    label       String
    description String?
    icon        String?
    color       String?

    categoryId String? @db.Uuid
    skillId    String? @db.Uuid

    createdById String?  @db.Uuid
    createdAt   DateTime @default(now())

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    skill        Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
    createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

    @@unique([organizationId, name])
    @@index([organizationId])
    @@index([categoryId])
    @@map("tags")
}

model Category {
    id             String  @id @default(uuid(7)) @db.Uuid
    organizationId String  @db.Uuid
    parentId       String? @db.Uuid

    name        String
    slug        String
    description String?
    icon        String?
    color       String?
    scope       CategoryScope

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
    children     Category[]   @relation("CategoryTree")

    tags       Tag[]
    skills     Skill[]
    userSkills UserSkill[]

    @@unique([organizationId, scope, slug])
    @@index([organizationId])
    @@map("categories")
}

enum CategoryScope {
    PROJECT
    TASK
    TAG
    SKILL
}

model Skill {
    id             String @id @default(uuid(7)) @db.Uuid
    organizationId String @db.Uuid

    name        String
    label       String
    description String?
    type        SkillType
    categoryId  String?   @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    userSkills   UserSkill[]
    tags         Tag[]

    @@unique([organizationId, name])
    @@index([organizationId])
    @@index([type])
    @@map("skills")
}

enum SkillType {
    HARD
    SOFT
}

model UserSkill {
    id             String @id @default(uuid(7)) @db.Uuid
    userId         String @db.Uuid
    skillId        String @db.Uuid
    organizationId String @db.Uuid

    level      Int
    levelLabel String?

    contextId   String? @db.Uuid
    contextType String?

    practiceCount Int @default(0)
    evidenceCount Int @default(0)

    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    skill        Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
    organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    context      Category?       @relation(fields: [contextId], references: [id], onDelete: SetNull)
    evidences    SkillEvidence[]

    @@unique([userId, skillId, organizationId, contextId])
    @@index([userId])
    @@index([skillId])
    @@map("user_skills")
}

model SkillEvidence {
    id          String @id @default(uuid(7)) @db.Uuid
    userSkillId String @db.Uuid

    type       EvidenceType
    sourceId   String?      @db.Uuid
    sourceType String?

    weight  Int     @default(1)
    comment String?

    createdById String?  @db.Uuid
    createdAt   DateTime @default(now())

    userSkill UserSkill @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
    createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

    @@index([userSkillId])
    @@map("skill_evidences")
}

enum EvidenceType {
    TASK_COMPLETED // закрытая задача
    INTERNAL_EXAM // внутренний экзамен
    EXTERNAL_EDUCATION // внешнее обучение, диплом
    IMPLEMENTATION // внедрение идеи
    HELPED_COLLEAGUE // помог коллеге
    MANUAL_GRANT // ручной подъём
    FACILITATION // разбор спорного случая
}

model TaskComplexity {
    id        String @id @default(uuid(7)) @db.Uuid
    recordId  String @db.Uuid
    projectId String @db.Uuid

    poEstimate       Int?
    teamEstimate     Int?
    executorEstimate Int?

    finalComplexity Int     @default(1)
    complexityLabel String?

    teamVotes Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    record  Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([recordId])
    @@index([projectId])
    @@map("task_complexities")
}

// ═══════════════════════════════════════════════════════════════
// INVITATIONS
// ═══════════════════════════════════════════════════════════════

model Invitation {
    id          String    @id @default(uuid(7)) @db.Uuid
    projectId   String    @db.Uuid
    email       String
    role        String    @default("member")
    token       String    @unique
    invitedById String    @db.Uuid
    expiresAt   DateTime
    acceptedAt  DateTime?
    createdAt   DateTime  @default(now())

    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    invitedBy User    @relation(fields: [invitedById], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([email])
    @@map("invitations")
}
